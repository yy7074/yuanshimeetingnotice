# Database (sqlite for dev, postgres for production)
DB_TYPE=sqlite
DB_DATABASE=conference.db
# For PostgreSQL:
# DB_TYPE=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_USERNAME=postgres
# DB_PASSWORD=postgres
# DB_DATABASE=conference_app

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Email (SMTP)
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your-email@qq.com
SMTP_PASS=your-smtp-password
SMTP_FROM=noreply@apscvir.org

# JPush (极光推送 - 国内推送)
# Register at https://www.jiguang.cn/
JPUSH_APP_KEY=
JPUSH_MASTER_SECRET=

# Firebase (海外推送 - optional)
# FIREBASE_SERVICE_ACCOUNT=/path/to/service-account.json

# App
PORT=3000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:5173
