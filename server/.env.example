# Copy to .env and fill in real values. DO NOT commit the filled-in .env.

# ---- Runtime ----
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
# Comma-separated list of allowed origins. In production, MUST be set.
# Never use `*` in production (credentials will be disabled).
CORS_ORIGIN=http://localhost:5173

# ---- Database ----
# sqlite (dev/default) or postgres (production recommended)
DB_TYPE=sqlite
DB_DATABASE=conference.db
# For PostgreSQL:
# DB_TYPE=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_USERNAME=postgres
# DB_PASSWORD=CHANGE_ME
# DB_DATABASE=conference_app
# Schema auto-sync. Forced to false in NODE_ENV=production regardless of this value.
DB_SYNCHRONIZE=true

# ---- Auth / JWT ----
# Generate a strong random string (e.g. `openssl rand -base64 48`). Required in production.
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_EXPIRES_IN=7d

# ---- Redis (optional) ----
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- Email / SMTP ----
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com

# ---- Verification code behavior ----
# When true, simulated code is returned in the response (for dev only). Forced to false in production.
AUTH_SIMULATE_VERIFICATION=true
AUTH_SIMULATED_CODE=0000
SCHEDULE_TIMEZONE=Asia/Shanghai

# ---- Push notification credentials ----
# JPush (domestic). Register at https://www.jiguang.cn/
JPUSH_APP_KEY=
JPUSH_MASTER_SECRET=
# Firebase (overseas)
# FIREBASE_SERVICE_ACCOUNT=/absolute/path/to/service-account.json

# ---- App links ----
APP_DOWNLOAD_URL=https://example.com/download

# ---- Deploy script (used by deploy.sh, do NOT commit real values) ----
# SERVER_IP=
# SERVER_USER=root
# SERVER_PASS=
# SSH_PORT=22
